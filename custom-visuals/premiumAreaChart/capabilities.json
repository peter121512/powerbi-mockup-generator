{
    "dataRoles": [
        {
            "displayName": "Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Values",
            "name": "values",
            "kind": "Measure",
            "requiredTypes": [
                { "numeric": true }
            ]
        }
    ],
    "objects": {},
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "dataReductionAlgorithm": { "top": { "count": 1000 } },
                    "for": {
                        "in": "category"
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "values"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "privileges": []
}
